# Development defaults for a laptop only. Copy to .env.
POSTGRES_PASSWORD=dev_superuser_pw
OWNER_PASSWORD=dev_owner_pw
LOADER_PASSWORD=dev_loader_pw
APP_PASSWORD=dev_app_pw
OPENAI_API_KEY=
BRAINTRUST_API_KEY=
# Demo only, off while empty. A database address with the loader's account (for a laptop:
# postgresql://claims_loader:<LOADER_PASSWORD>@db:5432/claims) adds a control that changes a claim mid-conversation.
ADMIN_DATABASE_URL=
# Hosted mode, off while 0: each visitor enters their own model key on the page and the server holds none (for a
# public demo on sample data only; see render.yaml).
HOSTED=0
